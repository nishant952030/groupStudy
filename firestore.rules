rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection: Any authenticated user can read profiles; user can write own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Squads Collection: Any authenticated user can query squads (by invite_code) or read/update squads they belong to
    match /squads/{squadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Progress Collection: Track solved problems per member
    match /progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Daily Tasks Collection: Track daily study goals
    match /daily_tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // General fallback for all documents for authenticated users
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
